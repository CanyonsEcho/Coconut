/* Coconut — Rounded Dark Gray & Purple Accent Theme (Clean Modern Sans-Serif) */

/* RmlUi Base Element Resets (required — RmlUi has no implicit UA stylesheet) */
div, p, h1, h2, h3 {
    display: block;
    box-sizing: border-box;
}

span {
    display: inline;
}

button {
    display: inline-block;
    box-sizing: border-box;
}

input {
    display: inline-block;
    box-sizing: border-box;
}

body {
    font-family: "PT Sans";
    font-size: 13dp;
    color: #e6e6eb;
    background-color: #111113;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

#app-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 8dp;
    gap: 8dp;
}

/* Top Bar */
#top-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 44dp;
    flex-shrink: 0;
    background-color: #1b1b1f;
    border: 1dp #2d2d35;
    border-radius: 12dp;
    padding: 0 14dp;
}

.brand-mark {
    font-weight: bold;
    font-size: 16dp;
    color: #a78bfa;
    margin-right: 16dp;
    letter-spacing: 0.8dp;
}

.toolbar-btn {
    background-color: #25252b;
    color: #dedee6;
    border: 1dp #383842;
    border-radius: 8dp;
    padding: 5dp 11dp;
    margin-right: 6dp;
    font-size: 12dp;
    text-align: center;
}

.toolbar-btn:hover {
    background-color: #30303a;
    border-color: #8b5cf6;
    color: #ffffff;
}

.toolbar-btn.primary {
    background-color: #7c3aed;
    border-color: #a78bfa;
    color: #ffffff;
    font-weight: bold;
}

.toolbar-btn.primary:hover {
    background-color: #8b5cf6;
}

.toolbar-btn.small {
    padding: 3dp 9dp;
    font-size: 11.5dp;
    border-radius: 7dp;
}

.spacer {
    flex: 1;
}

.badge {
    display: inline-block;
    font-size: 11.5dp;
    padding: 3dp 10dp;
    border-radius: 999dp;
    margin-left: 6dp;
    background-color: #24242a;
    border: 1dp #373742;
    color: #b8b8c4;
}

.badge-accent {
    background-color: #2b2042;
    border-color: #7c3aed;
    color: #ddd6fe;
}

.mini-tag {
    display: inline-block;
    font-size: 10.5dp;
    padding: 1dp 6dp;
    border-radius: 999dp;
    margin-left: 6dp;
    background-color: #2a213d;
    border: 1dp #5d3ea8;
    color: #cbb8ff;
}

/* Main Workspace */
#workspace {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 8dp;
}

.dock-panel {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #19191d;
    border: 1dp #2c2c34;
    border-radius: 12dp;
    overflow: hidden;
    min-height: 0;
}

#left-dock {
    width: 268dp;
    flex-shrink: 0;
}

#right-dock {
    width: 325dp;
    flex-shrink: 0;
}

#center-column {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    gap: 8dp;
}

/* Tabs */
.tab-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 36dp;
    flex-shrink: 0;
    background-color: #202026;
    border-bottom: 1dp #2d2d35;
    padding: 0 8dp;
    gap: 4dp;
}

.tab-btn {
    padding: 5dp 11dp;
    font-size: 12dp;
    color: #9797a4;
    border-radius: 8dp;
    border: 1dp transparent;
}

.tab-btn:hover {
    color: #f3f3f8;
    background-color: #2b2b33;
}

.tab-btn.active {
    color: #ede9fe;
    background-color: #2d2147;
    border-color: #7c3aed;
    font-weight: bold;
}

.sub-toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 6dp 10dp;
    background-color: #1e1e23;
    border-bottom: 1dp #2a2a32;
    gap: 6dp;
}

.panel-body {
    flex: 1;
    width: 100%;
    padding: 10dp;
    overflow: auto;
    min-height: 0;
}

#center-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #18181c;
    border: 1dp #2c2c34;
    border-radius: 12dp;
    overflow: hidden;
    min-height: 0;
}

#bottom-dock {
    height: 196dp;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #19191d;
    border: 1dp #2c2c34;
    border-radius: 12dp;
    overflow: hidden;
}

/* Scene Viewport */
.stage-view {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
    overflow: hidden;
}

#scene-viewport-wrap {
    flex: 1;
    margin: 8dp;
    border-radius: 10dp;
    overflow: hidden;
    border: 1dp #30303a;
    background-color: #141418;
    display: flex;
    min-height: 0;
}

#scene-viewport-img {
    width: 100%;
    height: 100%;
}

/* Hierarchy & Symbol Tree */
.tree-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 5dp 10dp;
    margin-bottom: 3dp;
    border-radius: 8dp;
    font-size: 12.5dp;
    color: #d6d6df;
    border: 1dp transparent;
}

.tree-row:hover {
    background-color: #25252c;
}

.tree-row.selected {
    background-color: #2d2147;
    border-color: #7c3aed;
    color: #ffffff;
    font-weight: bold;
}

.tree-row.muted {
    color: #727280;
}

.tree-label {
    display: inline-block;
    color: #e4e4ec;
}

.node-dot {
    display: inline-block;
    width: 6dp;
    height: 6dp;
    border-radius: 999dp;
    background-color: #8b5cf6;
    margin-right: 8dp;
    flex-shrink: 0;
}

.sym-kind {
    display: inline-block;
    font-size: 10dp;
    padding: 1dp 6dp;
    border-radius: 5dp;
    background-color: #2b2042;
    color: #c4b5fd;
    margin-right: 7dp;
    font-weight: bold;
    flex-shrink: 0;
}

/* Ghidra Dual Decompiler Split */
.dual-pane {
    flex: 1;
    display: flex;
    flex-direction: row;
    gap: 8dp;
    padding: 8dp;
    min-height: 0;
}

.code-pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    background-color: #141418;
    border: 1dp #2c2c35;
    border-radius: 10dp;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
}

.pane-caption {
    flex-shrink: 0;
    width: 100%;
    padding: 7dp 12dp;
    font-size: 12dp;
    font-weight: bold;
    color: #c4b5fd;
    background-color: #1d1d23;
    border-bottom: 1dp #2b2b34;
}

.code-scroll {
    flex: 1;
    width: 100%;
    padding: 10dp 12dp;
    overflow: auto;
    min-height: 0;
}

.code-block {
    display: block;
    width: 100%;
    font-size: 12dp;
    line-height: 1.5;
    color: #e0e0e8;
}

.code-line {
    display: block;
    width: 100%;
    white-space: pre;
    min-height: 17dp;
    line-height: 1.48;
}

.small-code {
    font-size: 11dp;
    line-height: 1.4;
}

/* Inspector Cards & Inputs */
.insp-card {
    display: block;
    width: 100%;
    background-color: #212127;
    border: 1dp #30303a;
    border-radius: 10dp;
    padding: 10dp 12dp;
    margin-bottom: 8dp;
}

.insp-card-title {
    display: block;
    font-weight: bold;
    font-size: 12.5dp;
    color: #d6c8ff;
    margin-bottom: 6dp;
}

.insp-card-sub {
    display: block;
    font-size: 11.5dp;
    color: #a8a8b5;
    margin-bottom: 4dp;
    line-height: 1.4;
}

.field-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 5dp;
    margin-bottom: 6dp;
}

.field-label {
    display: inline-block;
    width: 44dp;
    flex-shrink: 0;
    font-size: 11.5dp;
    color: #a4a4b2;
}

input.text-input {
    background-color: #151519;
    color: #efeff5;
    border: 1dp #363642;
    border-radius: 7dp;
    padding: 4dp 7dp;
    font-size: 12dp;
    flex: 1;
    min-width: 36dp;
    height: 26dp;
}

input.text-input:focus {
    border-color: #8b5cf6;
}

/* Asset Preview & Waveform */
.preview-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10dp;
}

.preview-title {
    font-weight: bold;
    font-size: 15dp;
    color: #f0eff8;
    margin-right: 10dp;
}

.preview-toolbar {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    margin-bottom: 10dp;
}

.tex-preview-frame {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #131317;
    border: 1dp #2f2f39;
    border-radius: 12dp;
    padding: 18dp;
}

.tex-preview-img {
    width: 240dp;
    height: 240dp;
    border-radius: 8dp;
}

.waveform-box {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 128dp;
    padding: 12dp;
    gap: 3dp;
    background-color: #141418;
    border: 1dp #2f2f38;
    border-radius: 10dp;
}

.wave-bar {
    flex: 1;
    background-color: #8b5cf6;
    border-radius: 4dp;
}

/* Bottom Asset Chips & XRefs */
#assets-list {
    display: block;
    width: 100%;
}

.asset-chip {
    display: inline-block;
    vertical-align: top;
    width: 162dp;
    background-color: #212127;
    border: 1dp #30303a;
    border-radius: 9dp;
    padding: 7dp 10dp;
    margin-right: 7dp;
    margin-bottom: 7dp;
}

.asset-chip:hover {
    border-color: #7c3aed;
    background-color: #282633;
}

.asset-chip.selected {
    background-color: #2d2147;
    border-color: #9d6eff;
}

.asset-chip-type { display: block; font-size: 10.5dp; color: #b794f4; font-weight: bold; }
.asset-chip-name { display: block; font-size: 12dp; color: #ececf2; margin-top: 2dp; overflow: hidden; white-space: nowrap; }
.asset-chip-meta { display: block; font-size: 10.5dp; color: #848492; margin-top: 2dp; }

.xref-row {
    display: block;
    width: 100%;
    padding: 5dp 10dp;
    margin-bottom: 4dp;
    border-radius: 7dp;
    background-color: #202026;
    font-size: 12dp;
}

/* Export & Fixup Pipeline Cards */
.export-grid {
    display: flex;
    flex-direction: row;
    width: 100%;
    gap: 10dp;
    padding: 10dp;
    flex: 1;
    min-height: 0;
}

.export-col {
    flex: 1;
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    min-height: 0;
    overflow: auto;
}

.toggle-pill {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background-color: #212127;
    border: 1dp #32323d;
    border-radius: 9dp;
    padding: 8dp 12dp;
    margin-bottom: 6dp;
    font-size: 12dp;
}

.toggle-pill.on {
    border-color: #7c3aed;
    background-color: #272038;
}

.empty-state {
    display: block;
    color: #888894;
    padding: 14dp;
    line-height: 1.55;
}

/* Syntax Highlighting (Dark Gray + Purple Accent) */
.syn-kw      { color: #b794f4; font-weight: bold; }
.syn-type    { color: #d6bcfa; }
.syn-string  { color: #a3be8c; }
.syn-number  { color: #e0af68; }
.syn-comment { color: #7e7e8e; }
.syn-addr    { color: #a78bfa; }
.syn-bytes   { color: #808090; }
.syn-op      { color: #ececf2; }

/* Status Bar */
#status-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 30dp;
    flex-shrink: 0;
    background-color: #1b1b1f;
    border: 1dp #2d2d35;
    border-radius: 10dp;
    padding: 0 14dp;
    font-size: 11.5dp;
    color: #a4a4b2;
}

/* Rounded Dark Gray & Purple Scrollbars (Required in RmlUi for overflow: auto!) */
scrollbarvertical {
    width: 10dp;
    background-color: #16161a;
    border-radius: 5dp;
}

scrollbarvertical slidertrack {
    background-color: #16161a;
    border-radius: 5dp;
}

scrollbarvertical sliderbar {
    width: 8dp;
    margin-left: 1dp;
    background-color: #3a3a46;
    border-radius: 4dp;
}

scrollbarvertical sliderbar:hover {
    background-color: #7c3aed;
}

scrollbarhorizontal {
    height: 10dp;
    background-color: #16161a;
    border-radius: 5dp;
}

scrollbarhorizontal slidertrack {
    background-color: #16161a;
    border-radius: 5dp;
}

scrollbarhorizontal sliderbar {
    height: 8dp;
    margin-top: 1dp;
    background-color: #3a3a46;
    border-radius: 4dp;
}

scrollbarhorizontal sliderbar:hover {
    background-color: #7c3aed;
}

scrollbarcorner {
    background-color: #16161a;
}
