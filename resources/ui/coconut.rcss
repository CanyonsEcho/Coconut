/* ============================================================================
 * Coconut v0.2 — Ghidra + Unity Editor Unified Dark Gray & Purple Theme
 * Clean Modern Sans-Serif (PT Sans / Arial-style), Rounded Surfaces, Zero Clutter
 * ============================================================================ */

* {
    box-sizing: border-box;
    font-family: "PT Sans";
}

body, div, section, header, footer, main, nav, aside, p, h1, h2, h3, h4, ul, li {
    display: block;
    margin: 0;
    padding: 0;
}

span, strong, em, label {
    display: inline;
}

body {
    width: 100%;
    height: 100%;
    background-color: #101014;
    color: #efeff4;
    font-size: 13dp;
    line-height: 1.38;
    overflow: hidden;
}

/* ---------- Custom Rounded Scrollbars (REQUIRED by RmlUi) ---------- */
scrollbarvertical {
    width: 8dp;
    background-color: #16161c;
    border-radius: 4dp;
}

scrollbarvertical slidertrack {
    background-color: #16161c;
    border-radius: 4dp;
}

scrollbarvertical sliderbar {
    background-color: #343442;
    border-radius: 4dp;
    min-height: 24dp;
}

scrollbarvertical sliderbar:hover {
    background-color: #7c3aed;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc,
scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    width: 0dp;
    height: 0dp;
}

scrollbarhorizontal {
    height: 8dp;
    background-color: #16161c;
    border-radius: 4dp;
}

scrollbarhorizontal slidertrack {
    background-color: #16161c;
    border-radius: 4dp;
}

scrollbarhorizontal sliderbar {
    background-color: #343442;
    border-radius: 4dp;
    min-width: 24dp;
}

scrollbarhorizontal sliderbar:hover {
    background-color: #7c3aed;
}

/* ---------- Root Shell Layout ---------- */
#app-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 8dp;
    gap: 8dp;
    background-color: #101014;
}

/* ---------- Top Persistent Navigation & Utility Bar ---------- */
#top-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 48dp;
    min-height: 48dp;
    padding: 0 12dp;
    background-color: #18181f;
    border: 1dp #282834;
    border-radius: 12dp;
    gap: 10dp;
}

.brand-cluster {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 8dp;
}

.brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28dp;
    height: 28dp;
    border-radius: 8dp;
    background-color: #7c3aed;
    color: #ffffff;
    font-weight: bold;
    font-size: 14dp;
}

.brand-name {
    font-size: 15dp;
    font-weight: bold;
    color: #f6f6fa;
}

.project-pill {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    padding: 4dp 10dp;
    background-color: #21212b;
    border: 1dp #303040;
    border-radius: 999dp;
    font-size: 12dp;
    color: #c7c7d6;
}

.project-pill-dot {
    width: 7dp;
    height: 7dp;
    border-radius: 4dp;
    background-color: #8b5cf6;
}

.utility-nav {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4dp;
    padding: 3dp;
    background-color: #121217;
    border: 1dp #252530;
    border-radius: 10dp;
}

.nav-btn {
    display: inline-block;
    padding: 6dp 12dp;
    border-radius: 8dp;
    background-color: transparent;
    color: #a6a6b8;
    font-size: 12.5dp;
    font-weight: bold;
    cursor: pointer;
    border: 1dp transparent;
}

.nav-btn:hover {
    background-color: #22222d;
    color: #f2f2f7;
}

.nav-btn.active {
    background-color: #7c3aed;
    color: #ffffff;
    border-color: #9333ea;
}

.top-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
}

.dirty-badge {
    display: inline-block;
    padding: 4dp 10dp;
    border-radius: 999dp;
    background-color: #2d1f4d;
    border: 1dp #7c3aed;
    color: #d8b4fe;
    font-size: 11.5dp;
    font-weight: bold;
}

.dirty-badge.clean {
    background-color: #1e1e26;
    border-color: #2d2d3a;
    color: #88889b;
}

/* ---------- Utility View Host ---------- */
#utility-host {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
}

.utility-view {
    display: none;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
    gap: 8dp;
}

.utility-view.active {
    display: flex;
}

/* ---------- Common Panels, Cards, Buttons, Inputs, Dropdowns ---------- */
.panel {
    display: flex;
    flex-direction: column;
    background-color: #18181f;
    border: 1dp #272733;
    border-radius: 12dp;
    overflow: hidden;
    min-height: 0;
}

.panel-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 36dp;
    min-height: 36dp;
    padding: 0 12dp;
    background-color: #1e1e27;
    border-bottom: 1dp #272733;
    gap: 8dp;
}

.panel-title {
    font-size: 12dp;
    font-weight: bold;
    color: #d4d4e0;
    letter-spacing: 0.4dp;
}

.panel-subtitle {
    font-size: 11.5dp;
    color: #8c8c9e;
}

.panel-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding: 10dp;
    gap: 8dp;
}

.scroll-pane {
    display: block;
    flex: 1;
    min-height: 0;
    width: 100%;
    overflow: auto;
    padding: 6dp;
}

.toolbar-strip {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-height: 40dp;
    padding: 5dp 10dp;
    background-color: #18181f;
    border: 1dp #272733;
    border-radius: 10dp;
    gap: 8dp;
}

.toolbar-group {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
}

.btn {
    display: inline-block;
    padding: 6dp 12dp;
    border-radius: 8dp;
    background-color: #252530;
    border: 1dp #343444;
    color: #e6e6f0;
    font-size: 12dp;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
}

.btn:hover {
    background-color: #30303f;
    border-color: #6d28d9;
    color: #ffffff;
}

.btn.active {
    background-color: #5b21b6;
    border-color: #8b5cf6;
    color: #ffffff;
}

.btn-primary {
    display: inline-block;
    padding: 8dp 16dp;
    border-radius: 9dp;
    background-color: #7c3aed;
    border: 1dp #9333ea;
    color: #ffffff;
    font-size: 13dp;
    font-weight: bold;
    cursor: pointer;
    text-align: center;
}

.btn-primary:hover {
    background-color: #8b5cf6;
    border-color: #a78bfa;
}

.btn-sm {
    padding: 4dp 9dp;
    font-size: 11.5dp;
    border-radius: 7dp;
}

.btn-danger {
    background-color: #2d1c22;
    border-color: #5a2634;
    color: #fca5a5;
}

.btn-danger:hover {
    background-color: #4c1d2b;
    border-color: #ef4444;
    color: #ffffff;
}

input.text-input {
    display: inline-block;
    height: 30dp;
    padding: 4dp 10dp;
    background-color: #131318;
    border: 1dp #2f2f3d;
    border-radius: 8dp;
    color: #f3f3f8;
    font-size: 12.5dp;
}

input.text-input:focus {
    border-color: #8b5cf6;
}

input.text-input-sm {
    height: 26dp;
    padding: 3dp 8dp;
    font-size: 12dp;
    border-radius: 7dp;
}

input.full-width {
    width: 100%;
}

/* ---------- Styled Native RmlUi <select> Dropdowns ---------- */
select {
    display: inline-block;
    height: 32dp;
    padding: 5dp 10dp;
    background-color: #14141a;
    border: 1dp #353548;
    border-radius: 8dp;
    color: #f2f2f7;
    font-size: 12.5dp;
    cursor: pointer;
}

select:hover, select:focus {
    border-color: #8b5cf6;
    background-color: #1c1c25;
}

selectvalue {
    display: inline-block;
    width: 100%;
    padding-right: 18dp;
    color: #f2f2f7;
    overflow: hidden;
}

selectarrow {
    width: 10dp;
    height: 10dp;
    background-color: #8b5cf6;
    border-radius: 5dp;
    margin-top: 5dp;
    margin-right: 2dp;
}

selectbox {
    background-color: #1b1b24;
    border: 1dp #6d28d9;
    border-radius: 9dp;
    padding: 4dp;
    max-height: 240dp;
    overflow-y: auto;
}

selectbox option {
    display: block;
    padding: 6dp 10dp;
    border-radius: 6dp;
    color: #dedee8;
    font-size: 12.5dp;
}

selectbox option:hover {
    background-color: #2b2342;
    color: #ffffff;
}

selectbox option:checked {
    background-color: #7c3aed;
    color: #ffffff;
    font-weight: bold;
}

/* ---------- Pill Badges ---------- */
.pill {
    display: inline-block;
    padding: 2dp 8dp;
    border-radius: 999dp;
    font-size: 11dp;
    font-weight: bold;
    background-color: #252532;
    color: #bdbdd0;
    border: 1dp #343445;
}

.pill-purple {
    background-color: #2c1e4a;
    border-color: #7c3aed;
    color: #d8b4fe;
}

.pill-green {
    background-color: #173324;
    border-color: #22c55e;
    color: #86efac;
}

.pill-muted {
    background-color: #1f1f28;
    border-color: #2c2c38;
    color: #8e8ea3;
}

/* ---------- Toggle Row ---------- */
.toggle-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 8dp 11dp;
    border-radius: 9dp;
    background-color: #14141a;
    border: 1dp #282836;
    cursor: pointer;
}

.toggle-row:hover {
    border-color: #6d28d9;
}

.toggle-state {
    display: inline-block;
    padding: 2dp 9dp;
    border-radius: 999dp;
    font-size: 11dp;
    font-weight: bold;
    background-color: #272734;
    color: #8d8da0;
}

.toggle-state.on {
    background-color: #7c3aed;
    color: #ffffff;
}

/* ============================================================================
 * UTILITY 1: GHIDRA-STYLE PROJECT MANAGER
 * ============================================================================ */
.tool-chest {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    width: 100%;
    min-height: 82dp;
}

.tool-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 11dp 13dp;
    background-color: #18181f;
    border: 1dp #2a2a38;
    border-radius: 12dp;
    cursor: pointer;
    gap: 4dp;
}

.tool-card:hover {
    background-color: #211c30;
    border-color: #8b5cf6;
}

.tool-card-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.tool-card-badge {
    display: inline-block;
    padding: 2dp 7dp;
    border-radius: 6dp;
    background-color: #2c1e4a;
    color: #c4b5fd;
    font-size: 10.5dp;
    font-weight: bold;
}

.tool-card-title {
    font-size: 14dp;
    font-weight: bold;
    color: #f4f4f9;
}

.tool-card-desc {
    font-size: 11.5dp;
    color: #9a9aad;
}

.manager-split {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 8dp;
}

.manager-left {
    width: 380dp;
    min-width: 340dp;
}

.manager-right {
    flex: 1;
    min-width: 0;
}

.new-project-card {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    padding: 12dp;
    margin: 8dp;
    background-color: #14141a;
    border: 1dp #362759;
    border-radius: 11dp;
}

.field-label {
    font-size: 11.5dp;
    font-weight: bold;
    color: #b5b5c8;
    margin-bottom: 3dp;
}

.project-item {
    display: flex;
    flex-direction: column;
    gap: 5dp;
    padding: 10dp 12dp;
    margin-bottom: 6dp;
    background-color: #14141a;
    border: 1dp #272734;
    border-radius: 10dp;
    cursor: pointer;
}

.project-item:hover {
    border-color: #6d28d9;
    background-color: #1c1a26;
}

.project-item.selected {
    border-color: #8b5cf6;
    background-color: #221c35;
}

.project-item-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 6dp;
}

.project-item-name {
    font-size: 13.5dp;
    font-weight: bold;
    color: #f3f3f8;
}

.project-item-path {
    font-size: 11dp;
    color: #858599;
    overflow: hidden;
}

.summary-banner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 12dp 14dp;
    background-color: #14141a;
    border-bottom: 1dp #262632;
    gap: 12dp;
}

.summary-stats {
    display: flex;
    flex-direction: row;
    gap: 8dp;
}

.mini-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 6dp 12dp;
    background-color: #1e1e28;
    border: 1dp #2d2d3c;
    border-radius: 9dp;
    min-width: 72dp;
}

.mini-stat-val {
    font-size: 15dp;
    font-weight: bold;
    color: #c4b5fd;
}

.mini-stat-lbl {
    font-size: 10.5dp;
    color: #8f8fa3;
}

.tree-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 5dp 9dp;
    border-radius: 7dp;
    margin-bottom: 2dp;
    cursor: pointer;
}

.tree-row:hover {
    background-color: #22222d;
}

.tree-row.selected {
    background-color: #2d1f4d;
    border: 1dp #7c3aed;
}

.tree-row-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 7dp;
}

.tree-row-name {
    font-size: 12.5dp;
    color: #e6e6f0;
}

.tree-row-meta {
    font-size: 11dp;
    color: #848499;
}

/* ============================================================================
 * UTILITY 2: GHIDRA CODEBROWSER
 * ============================================================================ */
.code-main {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 8dp;
}

.code-left {
    display: flex;
    flex-direction: column;
    width: 280dp;
    min-width: 240dp;
    gap: 8dp;
    min-height: 0;
}

.program-tree-panel {
    height: 30%;
    min-height: 130dp;
}

.symbol-tree-panel {
    flex: 1;
    min-height: 0;
}

.code-center {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-width: 0;
    min-height: 0;
    gap: 8dp;
}

.listing-panel, .decompile-panel {
    flex: 1;
    min-width: 0;
}

.listing-cols-header {
    display: flex;
    flex-direction: row;
    padding: 5dp 10dp;
    background-color: #14141b;
    border-bottom: 1dp #272734;
    font-size: 11dp;
    font-weight: bold;
    color: #8f8fa6;
}

.listing-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    padding: 3dp 8dp;
    border-radius: 5dp;
    font-size: 12dp;
}

.listing-row:hover {
    background-color: #211e2e;
}

.col-addr { width: 88dp; min-width: 88dp; color: #a78bfa; font-weight: bold; }
.col-bytes { width: 102dp; min-width: 102dp; color: #7e7e94; }
.col-op { flex: 1; color: #ededf5; }
.col-cmt { color: #6ee7b7; padding-left: 8dp; }

.listing-section {
    display: block;
    width: 100%;
    padding: 5dp 8dp 3dp 8dp;
    margin-top: 4dp;
    border-top: 1dp #252532;
    color: #9f8fef;
    font-size: 11.5dp;
    font-weight: bold;
}

.code-line {
    display: block;
    width: 100%;
    padding: 1.5dp 8dp;
    font-size: 12.5dp;
    line-height: 1.48;
    color: #ececf4;
    min-height: 18dp;
}

.code-ln {
    display: inline-block;
    width: 34dp;
    min-width: 34dp;
    color: #5f5f73;
    text-align: right;
    padding-right: 10dp;
}

.code-body {
    flex: 1;
    color: #ececf4;
    white-space: pre-wrap;
}

/* Syntax Highlighting (Clean Dark Gray + Purple/Emerald/Amber) */
.tok-kw,  .syn-kw      { color: #c084fc; font-weight: bold; }
.tok-ty,  .syn-type    { color: #93c5fd; }
.tok-fn,  .syn-addr    { color: #ddd6fe; font-weight: bold; }
.tok-str, .syn-string  { color: #86efac; }
.tok-num, .syn-number  { color: #fcd34d; }
.tok-cmt, .syn-comment { color: #717187; }
.tok-op,  .syn-op      { color: #e2e2ee; }
.syn-bytes             { color: #8b8ba0; }

.code-bottom {
    height: 165dp;
    min-height: 140dp;
}

/* ============================================================================
 * UTILITY 3: UNITY-STYLE SCENE EDITOR
 * ============================================================================ */
.scene-main {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 8dp;
}

.scene-hierarchy {
    width: 245dp;
    min-width: 210dp;
}

.scene-viewport-panel {
    flex: 1;
    min-width: 0;
    position: relative;
}

.viewport-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    width: 100%;
    background-color: #111116;
    overflow: hidden;
}

#scene-viewport-img {
    display: block;
    width: 100%;
    height: 100%;
}

.viewport-hud {
    position: absolute;
    top: 10dp;
    left: 10dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6dp;
    padding: 5dp 10dp;
    border-radius: 999dp;
    background-color: rgba(18, 18, 24, 210);
    border: 1dp #343446;
    font-size: 11.5dp;
    color: #d4d4e2;
}

.scene-inspector {
    width: 315dp;
    min-width: 280dp;
}

.comp-card {
    display: flex;
    flex-direction: column;
    gap: 8dp;
    padding: 10dp 11dp;
    margin-bottom: 8dp;
    background-color: #14141a;
    border: 1dp #282836;
    border-radius: 10dp;
}

.comp-head {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6dp;
    border-bottom: 1dp #242430;
}

.comp-title {
    font-size: 12.5dp;
    font-weight: bold;
    color: #e9e9f2;
}

.vec3-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 5dp;
    width: 100%;
}

.vec3-label {
    width: 58dp;
    min-width: 58dp;
    font-size: 11.5dp;
    color: #a1a1b5;
}

.axis-tag {
    display: inline-block;
    width: 18dp;
    min-width: 18dp;
    height: 24dp;
    line-height: 24dp;
    text-align: center;
    border-radius: 5dp;
    font-size: 11dp;
    font-weight: bold;
    color: #ffffff;
}

.axis-x { background-color: #b91c1c; }
.axis-y { background-color: #15803d; }
.axis-z { background-color: #1d4ed8; }

input.vec3-input {
    flex: 1;
    min-width: 40dp;
    height: 24dp;
    padding: 2dp 5dp;
    background-color: #101015;
    border: 1dp #2f2f3e;
    border-radius: 6dp;
    color: #f0f0f6;
    font-size: 11.5dp;
}

input.vec3-input:focus {
    border-color: #8b5cf6;
}

.prop-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4dp 6dp;
    border-radius: 6dp;
    background-color: #1a1a22;
    font-size: 11.5dp;
}

.prop-key { color: #9c9cb0; }
.prop-val { color: #e5e5f0; font-weight: bold; }

.scene-bottom {
    height: 180dp;
    min-height: 150dp;
}

.asset-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 7dp;
    width: 100%;
    padding: 4dp;
}

.asset-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 148dp;
    height: 62dp;
    padding: 8dp 10dp;
    background-color: #14141a;
    border: 1dp #282836;
    border-radius: 9dp;
    cursor: pointer;
}

.asset-card:hover {
    border-color: #8b5cf6;
    background-color: #211c32;
}

.asset-card.selected {
    border-color: #a78bfa;
    background-color: #2b1e4a;
}

.asset-card-name {
    font-size: 12dp;
    font-weight: bold;
    color: #f0f0f6;
    overflow: hidden;
}

/* ============================================================================
 * UTILITY 4: BUNDLE & ASSET EDITOR
 * ============================================================================ */
.bundle-main {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 8dp;
}

.bundle-left { width: 295dp; min-width: 260dp; }
.bundle-center { flex: 1; min-width: 0; }
.bundle-right { width: 300dp; min-width: 260dp; }

.preview-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16dp;
    background-color: #121218;
    border: 1dp #272735;
    border-radius: 11dp;
    min-height: 220dp;
    gap: 10dp;
}

#asset-texture-img {
    max-width: 300dp;
    max-height: 240dp;
    border-radius: 8dp;
    border: 1dp #343446;
}

.waveform-box {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    gap: 3dp;
    width: 100%;
    height: 110dp;
    padding: 10dp;
    background-color: #13131a;
    border-radius: 9dp;
    border: 1dp #292938;
}

.wave-bar {
    width: 6dp;
    background-color: #8b5cf6;
    border-radius: 3dp;
}

.hex-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    padding: 2.5dp 6dp;
    border-radius: 5dp;
    font-size: 12dp;
}

.hex-row:hover { background-color: #201c2d; }
.hex-off { width: 76dp; min-width: 76dp; color: #a78bfa; font-weight: bold; }
.hex-bytes { flex: 1; color: #e2e2ee; letter-spacing: 0.4dp; }
.hex-ascii { width: 145dp; min-width: 145dp; color: #86efac; }

/* ============================================================================
 * UTILITY 5 & 6: PROJECT EXPORTER & GAME EXPORTER
 * ============================================================================ */
.wizard-split {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 10dp;
}

.wizard-config {
    width: 465dp;
    min-width: 420dp;
}

.wizard-results {
    flex: 1;
    min-width: 0;
}

.form-grid-2 {
    display: flex;
    flex-direction: row;
    gap: 10dp;
    width: 100%;
}

.form-col {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 4dp;
}

.kpi-row {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    width: 100%;
}

.kpi-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 11dp 14dp;
    background-color: #14141a;
    border: 1dp #292938;
    border-radius: 11dp;
    gap: 2dp;
}

.kpi-val {
    font-size: 20dp;
    font-weight: bold;
    color: #c4b5fd;
}

.kpi-label {
    font-size: 11.5dp;
    color: #9393a8;
}

.log-box {
    display: block;
    flex: 1;
    min-height: 160dp;
    width: 100%;
    padding: 10dp 12dp;
    background-color: #111116;
    border: 1dp #262634;
    border-radius: 10dp;
    color: #c9c9d8;
    font-size: 12dp;
    line-height: 1.5;
    overflow: auto;
    white-space: pre-wrap;
}

/* ---------- Bottom Compact Status Bar ---------- */
#status-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 28dp;
    min-height: 28dp;
    padding: 0 12dp;
    background-color: #18181f;
    border: 1dp #262633;
    border-radius: 9dp;
    font-size: 11.5dp;
    color: #9b9bae;
    overflow: hidden;
    white-space: nowrap;
}
