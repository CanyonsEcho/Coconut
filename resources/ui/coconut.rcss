/* Coconut — Rounded Dark Gray & Purple Accent Theme (Clean Modern Serif) */

body {
    font-family: "PT Serif";
    font-size: 13dp;
    color: #e6e6eb;
    background-color: #121214;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

#app-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 8dp;
    box-sizing: border-box;
    gap: 8dp;
}

/* Top Bar */
#top-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 44dp;
    background-color: #1c1c20;
    border: 1dp #2d2d34;
    border-radius: 11dp;
    padding: 0 14dp;
}

.brand-mark {
    font-weight: bold;
    font-size: 16dp;
    color: #a78bfa;
    margin-right: 18dp;
    letter-spacing: 0.8dp;
}

.toolbar-btn {
    background-color: #25252b;
    color: #d8d8df;
    border: 1dp #383842;
    border-radius: 8dp;
    padding: 5dp 12dp;
    margin-right: 7dp;
    font-size: 12.5dp;
}

.toolbar-btn:hover {
    background-color: #2f2f38;
    border-color: #8b5cf6;
    color: #ffffff;
}

.toolbar-btn.primary {
    background-color: #7c3aed;
    border-color: #9d6eff;
    color: #ffffff;
    font-weight: bold;
}

.toolbar-btn.primary:hover {
    background-color: #8b5cf6;
}

.spacer {
    flex: 1;
}

.badge {
    font-size: 11.5dp;
    padding: 3dp 10dp;
    border-radius: 999dp;
    margin-left: 7dp;
    background-color: #24242a;
    border: 1dp #373740;
    color: #b4b4c0;
}

.badge-accent {
    background-color: #2a213d;
    border-color: #6d46c4;
    color: #d4c5ff;
}

.badge-cyan {
    background-color: #231e33;
    border-color: #5b3da8;
    color: #c4b5fd;
}

/* Main Workspace */
#workspace {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
    gap: 8dp;
}

.dock-panel {
    display: flex;
    flex-direction: column;
    background-color: #1a1a1e;
    border: 1dp #2c2c33;
    border-radius: 12dp;
    overflow: hidden;
    min-height: 0;
}

#left-dock {
    width: 280dp;
}

#center-column {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
    gap: 8dp;
}

#right-dock {
    width: 320dp;
}

/* Tab Strip */
.tab-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 36dp;
    background-color: #202025;
    border-bottom: 1dp #2c2c34;
    padding: 0 8dp;
    gap: 4dp;
}

.tab-btn {
    padding: 5dp 12dp;
    font-size: 12.5dp;
    color: #9494a1;
    border-radius: 8dp;
    border: 1dp transparent;
}

.tab-btn:hover {
    color: #f0f0f5;
    background-color: #2a2a31;
}

.tab-btn.active {
    color: #e4dbff;
    background-color: #2d2244;
    border-color: #7c3aed;
    font-weight: bold;
}

.panel-body {
    flex: 1;
    padding: 12dp;
    overflow: auto;
    min-height: 0;
}

#center-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #18181c;
    border: 1dp #2c2c33;
    border-radius: 12dp;
    overflow: hidden;
    min-height: 0;
}

#bottom-dock {
    height: 215dp;
    display: flex;
    flex-direction: column;
    background-color: #1a1a1e;
    border: 1dp #2c2c33;
    border-radius: 12dp;
    overflow: hidden;
}

.code-block {
    font-size: 12.5dp;
    line-height: 1.5;
    white-space: pre;
    color: #dedee6;
}

.empty-state {
    color: #888894;
    padding: 18dp;
    line-height: 1.6;
}

/* Syntax Highlighting (Dark Gray + Purple Accent Harmony) */
.syn-kw      { color: #b794f4; font-weight: bold; }
.syn-type    { color: #d6bcfa; }
.syn-string  { color: #a3be8c; }
.syn-number  { color: #e0af68; }
.syn-comment { color: #757584; }
.syn-addr    { color: #9c88cc; }
.syn-bytes   { color: #6e6e7c; }
.syn-op      { color: #ececf2; }

/* Status Bar */
#status-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 30dp;
    background-color: #1c1c20;
    border: 1dp #2c2c33;
    border-radius: 10dp;
    padding: 0 14dp;
    font-size: 11.5dp;
    color: #9e9eaa;
}
