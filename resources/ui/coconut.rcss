/* Coconut — Obsidian & Amber Engineering Theme (Ghidra + Unity Editor) */

body {
    font-family: "IBM Plex Sans";
    font-size: 13dp;
    color: #d8dee9;
    background-color: #13161a;
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

#app-shell {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

/* Top Bar */
#top-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 36dp;
    background-color: #1a1e24;
    border-bottom: 1dp #2c333d;
    padding: 0 12dp;
}

.brand-mark {
    font-weight: bold;
    font-size: 14dp;
    color: #e89b3c;
    margin-right: 16dp;
    letter-spacing: 0.6dp;
}

.toolbar-btn {
    background-color: #222730;
    color: #cfd6e0;
    border: 1dp #323a46;
    border-radius: 3dp;
    padding: 4dp 10dp;
    margin-right: 6dp;
    font-size: 12dp;
}

.toolbar-btn:hover {
    background-color: #2c3340;
    border-color: #e89b3c;
    color: #ffffff;
}

.toolbar-btn.primary {
    background-color: #b87320;
    border-color: #e89b3c;
    color: #ffffff;
    font-weight: bold;
}

.toolbar-btn.primary:hover {
    background-color: #d1862a;
}

.spacer {
    flex: 1;
}

.badge {
    font-family: "JetBrains Mono";
    font-size: 11dp;
    padding: 2dp 7dp;
    border-radius: 3dp;
    margin-left: 6dp;
    background-color: #212730;
    border: 1dp #333c48;
    color: #9ba7b8;
}

.badge-accent {
    background-color: #2c2318;
    border-color: #8f5c1e;
    color: #f0ad56;
}

.badge-cyan {
    background-color: #15282c;
    border-color: #26606b;
    color: #5cd3e0;
}

/* Main Workspace */
#workspace {
    display: flex;
    flex-direction: row;
    flex: 1;
    min-height: 0;
}

.dock-panel {
    display: flex;
    flex-direction: column;
    background-color: #171b20;
    min-height: 0;
}

#left-dock {
    width: 270dp;
    border-right: 1dp #2a313b;
}

#center-column {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    min-height: 0;
}

#right-dock {
    width: 310dp;
    border-left: 1dp #2a313b;
}

/* Tab Strip */
.tab-bar {
    display: flex;
    flex-direction: row;
    height: 30dp;
    background-color: #1c2128;
    border-bottom: 1dp #2a313b;
    padding: 0 4dp;
}

.tab-btn {
    padding: 6dp 12dp;
    font-size: 12dp;
    color: #8b95a5;
    border-bottom: 2dp transparent;
}

.tab-btn:hover {
    color: #e4e9f0;
    background-color: #232932;
}

.tab-btn.active {
    color: #f0ad56;
    border-bottom: 2dp #e89b3c;
    background-color: #171b20;
    font-weight: bold;
}

.panel-body {
    flex: 1;
    padding: 10dp;
    overflow: auto;
    min-height: 0;
}

#center-stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    background-color: #111418;
    min-height: 0;
}

#bottom-dock {
    height: 210dp;
    border-top: 1dp #2a313b;
    display: flex;
    flex-direction: column;
    background-color: #161a1f;
}

.code-block {
    font-family: "JetBrains Mono";
    font-size: 12dp;
    line-height: 1.45;
    white-space: pre;
    color: #d0d7e2;
}

.empty-state {
    color: #7d8796;
    padding: 18dp;
    line-height: 1.5;
}

/* Syntax Highlighting */
.syn-kw      { color: #e89b3c; font-weight: bold; }
.syn-type    { color: #5cd3e0; }
.syn-string  { color: #98c379; }
.syn-number  { color: #d19a66; }
.syn-comment { color: #677282; }
.syn-addr    { color: #7f8fa6; }
.syn-bytes   { color: #5a6575; }
.syn-op      { color: #e2e8f0; }

/* Status Bar */
#status-bar {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 24dp;
    background-color: #1a1e24;
    border-top: 1dp #2a313b;
    padding: 0 12dp;
    font-size: 11dp;
    color: #8f9aa8;
}
